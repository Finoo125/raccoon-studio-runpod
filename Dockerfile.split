# syntax=docker/dockerfile:1
# Raccoon Studio — RunPod pre-installed image, LAYER-SPLIT variant.
#
# Same install as runpod/Dockerfile, cut into two big layers instead of one.
#
# Why: a pod's boot from this template is 97% registry pull (measured
# 2026-08-20 — 373 s of a 383 s boot; the app is up 10 s after the container
# starts). All of that was ONE 10.57 GB layer, which cannot download in
# parallel, whose extract cannot overlap its own download, and which no two
# releases share a byte of.
#
# The cut is torch + its CUDA libraries, the single biggest thing in the image,
# seeded into the venv the installer will use. The installer's step 7 then runs
# the same `uv pip install torch torchvision torchaudio` against that venv, uv
# audits it as satisfied, and the 2.5 GB download becomes a no-op.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    RACCOON_ROOT=/opt/raccoon \
    RACCOON_WORKSPACE=/workspace \
    PATH=/root/.local/bin:$PATH

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git python3.12 python3.12-venv \
 && rm -rf /var/lib/apt/lists/*

COPY . /opt/raccoon
WORKDIR /opt/raccoon

# ── Layer 1 of the split: ComfyUI + venv + torch ─────────────────────────────
# The clone has to happen here too, not just the venv. install-linux.sh step 6
# does `git clone` into $COMFYUI_DIR, and git refuses a non-empty target — so a
# venv seeded at $COMFYUI_DIR/.venv with no clone beside it would fail the
# build. With main.py present the installer takes its "already exists" branch
# and pins the revision, which is what we want anyway.
#
# Both the clone URL and the torch install line are duplicated from
# install-linux.sh (steps 6 and 7). The guard in the next stage is what stops
# that duplication from rotting silently.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
 && git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git \
      /opt/raccoon/comfyui/ComfyUI \
 && uv venv /opt/raccoon/comfyui/ComfyUI/.venv --python python3.12 --seed \
 && uv pip install --python /opt/raccoon/comfyui/ComfyUI/.venv/bin/python \
      torch torchvision torchaudio \
      --extra-index-url https://download.pytorch.org/whl/cu128 \
 && rm -rf /root/.cache

# ── Layer 2 of the split: everything else ────────────────────────────────────
# Unchanged from runpod/Dockerfile. If the pre-seed above ever stops matching
# what the installer wants, this still produces a correct image - it just
# re-downloads torch and the split silently stops paying. Hence the assertion:
# a second torch copy means the layers no longer divide the way this file
# claims, and that should fail the build rather than ship a fat image.
RUN RS_FROM_ENGINE=1 bash install-linux.sh --gpu=nvidia --skip-controlnet \
 && rm -rf /root/.cache /root/.npm \
 && test -f /opt/raccoon/comfyui/ComfyUI/main.py \
 && echo '── layer sizes (what to cut next) ──' \
 && du -sh /opt/raccoon/comfyui/ComfyUI/.venv/lib/python3.12/site-packages/torch \
           /opt/raccoon/comfyui/ComfyUI/.venv/lib/python3.12/site-packages/nvidia \
           /opt/raccoon/comfyui/ComfyUI/.venv \
           /opt/raccoon/comfyui/ComfyUI/custom_nodes \
           /opt/raccoon/comfyui/ComfyUI/models \
           /opt/raccoon/app/node_modules 2>/dev/null || true

RUN cd app && RACCOON_KIOSK=1 npm run build

EXPOSE 8080

CMD ["bash", "/opt/raccoon/runpod/entrypoint.sh"]
